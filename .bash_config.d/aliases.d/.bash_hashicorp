#! /bin/bash

# set required variables in specific.d/hashicorp.sh so that they're untracked

function vault_login {
  export VAULT_TOKEN=$(vault login -method=oidc -path=authentik -token-only role="$1")
  echo "Vault token: $VAULT_TOKEN"
}

function vault_login_ldap {
  export VAULT_TOKEN=$(vault login -method=ldap -path=ldap -token-only username=$1)
  echo "Vault token: $VAULT_TOKEN"
}

function consul_login {
  export CONSUL_HTTP_TOKEN=$(vault read -field=token consul/creds/$1)
  echo "Consul token: $CONSUL_HTTP_TOKEN"
}

complete -C /usr/bin/consul consul
complete -C /usr/bin/vault vault
complete -C /usr/sbin/tofu tofu
