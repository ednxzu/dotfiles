{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "plugins": ["@openchamber/opencode-claude"],
  "provider": {
    "infomaniak": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "infomaniak",
      "options": {
        "baseURL": "{env:OPENAI_BASE_URL}",
        "headers": {
          "X-LLM-Application-Tag": "codegpt",
          "Authorization": "Bearer {env:OPENAI_API_KEY}"
        }
      },
      "models": {
        "euria-code": {
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "name": "euria-code",
          "limit": {
            "context": 250000,
            "output": 100000
          },
          "cost": {
            "input": 0.6,
            "output": 3.0
          }
        },
        "euria-code-tiny": {
          "modalities": {
            "input": ["text", "image"],
            "output": ["text"]
          },
          "name": "euria-code-tiny",
          "limit": {
            "context": 200000,
            "output": 100000
          },
          "cost": {
            "input": 0.3,
            "output": 2.4
          }
        }
      }
    }
  },
  "model": "claude-code/claude-opus-5-5[1m]",
  "mcp": {
    "gitlab-ednz": {
      "type": "remote",
      "url": "https://gitlab.ednz.fr/api/v4/mcp",
      "enabled": true
    }
    "gitlab-infomaniak": {
      "type": "remote",
      "url": "https://gitlab.infomaniak.ch/api/v4/mcp",
      "enabled": true
    }
  },
  "default_agent": "plan",
  "agent": {
    "build": {
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git diff*": "allow",
          "git log *": "allow",
          "grep *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "find *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "awk *": "allow",
          "awk *inplace*": "ask",
          "awk *system*": "ask",
          "sort *": "allow",
          "uniq *": "allow",
          "wc *": "allow",
          "sed *": "ask",
          "osascript *": "ask",
          "xargs *": "ask",
          "*-exec*": "ask",
          "watch *": "ask",
          "env *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny"
        },
        "webfetch": "ask"
      }
    },
    "plan": {
      "tools": {
        "write": false
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "cat *": "allow",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git show *": "allow",
          "diff *": "allow",
          "echo *": "allow",
          "grep *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "find *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "awk *": "allow",
          "awk *inplace*": "ask",
          "awk *system*": "ask",
          "sort *": "allow",
          "uniq *": "allow",
          "wc *": "allow",
          "sed *": "ask",
          "osascript *": "ask",
          "xargs *": "ask",
          "*-exec*": "ask",
          "watch *": "ask",
          "env *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny"
        },
        "webfetch": "ask"
      }
    }
  }
}
