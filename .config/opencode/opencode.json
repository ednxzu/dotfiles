{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "plugins": ["@openchamber/opencode-claude"],
  "provider": {},
  "model": "",
  "default_agent": "plan",
  "agent": {
    "build": {
      "model": "infomaniak/euria-code",
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git diff*": "allow",
          "git log *": "allow",
          "grep *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "find *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "awk *": "allow",
          "awk *inplace*": "ask",
          "awk *system*": "ask",
          "sort *": "allow",
          "uniq *": "allow",
          "wc *": "allow",
          "sed *": "ask",
          "osascript *": "ask",
          "xargs *": "ask",
          "*-exec*": "ask",
          "watch *": "ask",
          "env *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny"
        },
        "webfetch": "ask"
      }
    },
    "plan": {
      "model": "infomaniak/euria-code",
      "tools": {
        "write": false
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "git status": "allow",
          "git diff*": "allow",
          "git log *": "allow",
          "grep *": "allow",
          "ls *": "allow",
          "pwd": "allow",
          "find *": "allow",
          "head *": "allow",
          "tail *": "allow",
          "awk *": "allow",
          "awk *inplace*": "ask",
          "awk *system*": "ask",
          "sort *": "allow",
          "uniq *": "allow",
          "wc *": "allow",
          "sed *": "ask",
          "osascript *": "ask",
          "xargs *": "ask",
          "*-exec*": "ask",
          "watch *": "ask",
          "env *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny"
        },
        "webfetch": "ask"
      }
    }
  }
}
